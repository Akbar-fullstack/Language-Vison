# 1. SUPABASE CONFIGURATION (FRONTEND & BACKEND)
VITE_SUPABASE_URL="https://kgmignmwdkywfhshdwex.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

SUPABASE_URL="https://kgmignmwdkywfhshdwex.supabase.co"
# ВАЖНО: Secret / Service Role ключ используется ТОЛЬКО на backend (server.ts) и никогда не передается в браузер!
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_SERVICE_ROLE_KEY"
SUPABASE_JWKS_URL="https://kgmignmwdkywfhshdwex.supabase.co/auth/v1/.well-known/jwks.json"

# 2. GEMINI AI API KEY (ДЛЯ AI-АССИСТЕНТА НА САЙТЕ)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 3. APPLICATION URL
APP_URL="http://localhost:3000"
